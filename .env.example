# Environment variable template — NAMES ONLY, no real values.
# Copy to .env.local for local dev (that file is git-ignored). In production,
# set these in Vercel → Project → Settings → Environment Variables.
# Never commit a populated env file.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
CLERK_SECRET_KEY=

# ── Database (Postgres / Neon) ───────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Admin panel ──────────────────────────────────────────────────────────────
ADMIN_USER=
ADMIN_PASSWORD=
# HMAC key that signs admin session cookies. Generate 32+ random bytes, e.g.
#   openssl rand -base64 32
# Rotating this invalidates every existing admin session.
ADMIN_SESSION_SECRET=

# ── Blog publishing API ──────────────────────────────────────────────────────
# Bearer token guarding /api/blog (also stored in bot/.secret-token for the
# publisher — rotate both together).
BLOG_API_TOKEN=

# ── Observability ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# BetterStack / Logtail source token (structured logs + security events).
LOGTAIL_SOURCE_TOKEN=
# BetterStack source-specific HTTP ingest host (e.g. https://sXXXXXX.<region>.betterstackdata.com)
LOGTAIL_INGEST_URL=

# ── Security: rate limiting (Upstash Redis, free tier) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Security: request-log ingest + weekly digest ─────────────────────────────
# Shared secret guarding the internal /api/internal/security-event writer.
SECURITY_INGEST_TOKEN=
# Bearer secret Vercel Cron sends to /api/cron/* (also set as CRON_SECRET in Vercel).
CRON_SECRET=
# Where the weekly security digest email is sent (defaults to the blog reply-to).
SECURITY_DIGEST_RECIPIENT=

# ── Deferred: Cloudflare Turnstile (enable only if subscribe abuse persists) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
